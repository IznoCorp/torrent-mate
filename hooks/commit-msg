#!/usr/bin/env bash
#
# commit-msg — the Commit Convention, enforced where the message is written.
#
# CLAUDE.md states the convention and names `hooks/block_ai_attribution.py` as
# what enforces the AI-attribution ban. THAT FILE DOES NOT EXIST. The real one
# lives under `.claude/`, is gitignored, and is a Claude-Code tool hook whose
# predicate is `if "git commit" not in command`: it cannot see a `git commit -F`,
# an editor commit, an amend, a rebase, or a commit made by anyone not driving
# the agent. A rule named after a file nobody has is a rule with no arm.
#
# This one runs on every commit in this repository, whoever writes it.
#
# What it CANNOT reach, said plainly rather than left to be discovered: the
# squash-merge message composed on GitHub, which is the message that actually
# lands on `main` under this project's merge strategy. Only a server-side check
# reaches that.
set -euo pipefail

message_file="$1"
# Comments and the diff `git commit -v` appends are not the message.
message="$(grep -v '^#' "$message_file" | sed '/^diff --git /,$d')"
subject="$(printf '%s\n' "$message" | head -1)"

fail() {
    printf '\n✖ commit-msg: %s\n\n' "$1" >&2
    printf '  subject: %s\n\n' "$subject" >&2
    exit 1
}

# A merge or a revert is generated by git and is not ours to shape.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# Conventional Commits: <type>[(<scope>)][!]: <description>
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|chore|refactor|style|docs|test|perf|build|ci)(\([a-z0-9._/-]+\))?!?: .+'; then
    fail "not a Conventional Commit. Expected « <type>[(<scope>)]: <description> » with type in
  feat | fix | chore | refactor | style | docs | test | perf | build | ci"
fi

# A version prefix — « v0.98.4: … » — is forbidden: version traceability lives
# in IMPLEMENTATION.md, not in commit subjects.
if printf '%s' "$subject" | grep -qE '^v?[0-9]+\.[0-9]+\.[0-9]+ *[:—-]'; then
    fail "version prefix in the subject. Version traceability lives in IMPLEMENTATION.md."
fi

# AI attribution, in the whole message rather than the subject: it is a TRAILER,
# and every alternative is anchored to a line start because of that.
# `claude-session:` joined this pattern on 2026-08-24 — the sub-agent harness had been
# writing it unmatched, 17 times across one wave's intermediate commits, because it names
# neither Claude nor Anthropic in a shape the three earlier alternatives read.
#
# TWO OF THE FOUR WERE UNANCHORED UNTIL L10-bis, and they caught prose. A commit
# explaining this very ban was refused by the hook it was explaining (B-058) —
# `generated with .*claude` and a bare `🤖` matched anywhere in the message,
# including inside a sentence describing what is forbidden. The two that were
# already anchored did not have the problem, which is what proved the anchor is
# the answer: a sentence quoting a `Co-Authored-By:` trailer mid-line has always
# passed.
#
# BOTH were anchored, not one. Fixing `generated with` alone would have left the
# emoji catching the same prose three characters later — a repair applied to one
# branch of a condition and not the other, which is the shape this repository
# has just paid for twice (B-208, A-1).
#
# WHAT IS NO LONGER CAUGHT, stated rather than discovered: an attribution buried
# mid-line — « … co-authored with 🤖 Claude … » inside a paragraph. That is not
# a trailer, no tool emits it, and refusing it is what made this hook refuse
# English. The real footers all begin their line, and the mutations below hold
# exactly that.
# THE ANCHOR CARRIES ITS PREFIXES, and leaving them out was a regression this
# hook shipped: `> 🤖 Generated with Claude Code`, `- 🤖 …` and `* Generated
# with Claude` all went from refused to accepted, and those three are the exact
# shapes the attribution arrives in — a quote marker or a list bullet, never a
# bare column one. An anchor that only knows column one is an anchor for a
# message nobody writes.
_LINE='^[[:space:]]*([>*+-][[:space:]]*)*'
if printf '%s' "$message" | grep -qiE "${_LINE}co-authored-by:.*(claude|anthropic)|${_LINE}🤖|${_LINE}generated with .*claude|${_LINE}claude-session:"; then
    fail "AI attribution trailer. CLAUDE.md forbids Co-Authored-By / Claude / Anthropic / Claude-Session."
fi

exit 0
