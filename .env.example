# ── qBittorrent ──────────────────────────────
# Host and port live in config/torrent.json5 (clients.qbittorrent.host / .port).
# Only credentials belong here.
QBIT_USERNAME=admin
QBIT_PASSWORD=

# ── Transmission ─────────────────────────────
# Alternative torrent client (config/torrent.json5 → torrent.active = "transmission").
# CONSUMED by the code: PROVIDER_CREDS["transmission"] gates activation on both.
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# ── TMDB / TVDB ──────────────────────────────
TMDB_API_KEY=
TVDB_API_KEY=

# ── Provider registry — optional credentials ─
# Trakt client ID (app-only auth). Enables RecommendationProvider + Searchable/Details.
# CONSUMED: PROVIDER_CREDS["trakt"] gates activation on TRAKT_CLIENT_ID alone.
TRAKT_CLIENT_ID=
# NOT consumed by any code: the client secret is OAuth-only, and OAuth user
# endpoints are deliberately out of scope. Kept as an operator note.
# TRAKT_CLIENT_SECRET=

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Plex (optional) ──────────────────────────
# Post-dispatch library refresh: after the pipeline moves media onto a disk, it
# asks Plex to scan THAT folder. The storage disks are macFUSE/NTFS mounts and
# deliver no filesystem events to Plex, so without this the media stays
# invisible until someone scans by hand.
# Server root (default http://localhost:32400 when unset).
PLEX_URL=http://localhost:32400
# CONSUMED (gating): auth token, sent as the X-Plex-Token header and never
# logged. Empty ⇒ the refresh subscriber is not wired and no request is made.
# Find it via Plex Web: any item → ⋯ → Get Info → View XML, then read the
# X-Plex-Token parameter of the resulting URL.
PLEX_TOKEN=

# ── Monitoring ───────────────────────────────
HEALTHCHECK_URL=

# ── Trailers (yt-dlp) ────────────────────────
# Requires ffmpeg on PATH: brew install ffmpeg / apt-get install ffmpeg

# YouTube Data API v3 key (primary trailer search path).
# Leave blank to fall back to yt-dlp `ytsearch1` (slower, no quota). The primary path
# costs 100 quota units per search.list call (default daily quota = 10 000 units).
# Get a key at: https://console.developers.google.com/apis/api/youtube.googleapis.com
YOUTUBE_API_KEY=

# YouTube cookies for yt-dlp bot-detection bypass (optional)
# Option A: static Netscape-format cookies.txt (must be on APFS-native storage, mode 600)
YOUTUBE_COOKIES_FILE=
# Option B: live extraction from a browser profile
# Valid values: firefox, chrome, chromium, edge, opera, brave, safari
YOUTUBE_COOKIES_FROM_BROWSER=

# ── OMDB ─────────────────────────────────────
# OMDb API key (required for OMDB/IMDb/Rotten Tomatoes ratings backfill
# during library-scan).  Free tier = 1000 req/day.
# Get a key at: http://www.omdbapi.com/apikey.aspx
# Leave blank to skip ratings backfill entirely.
OMDB_API_KEY=

# Daily request limit override (default: 1000, the OMDB free tier quota).
# Patreon $1 tier = 100 000 req/day.  Only active when OMDB_API_KEY is set.
# OMDB_DAILY_LIMIT=1000

# ── Library Analyzer ─────────────────────────
# Max worker threads for library-analyze video analysis (default: 4).
# The cap of 4 targets NTFS-USB mechanical drives to avoid I/O saturation.
# Override for SSD or NVMe libraries with higher concurrency.
# LIBRARY_ANALYZER_MAX_WORKERS=4

# ── TorrentMate Web UI ────────────────────────
# Password hash for web UI login (generated by `personalscraper web set-password`).
# Uses hashlib.scrypt with format: scrypt$N$r$p$salt$hash
WEB_PASSWORD_HASH=
# HS256 secret key for JWT session tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
WEB_JWT_SECRET=
# Deployment role for the web daemon (config-editor S4). "staging" makes every
# config write endpoint return 403 (read-only editor); anything else = prod.
# Set per PM2 app in ecosystem.config.js, not here.
# PERSONALSCRAPER_WEB_ROLE=staging
# PM2 app name targeted by POST /api/config/restart-web (config-editor S4).
# Unset = the restart endpoint returns 404 and the button is hidden in the UI.
# PERSONALSCRAPER_PM2_NAME=torrentmate-web

# ── Trackers ─────────────────────────────────
# Which trackers are enabled + their priority lives in config/tracker.json5.
# Only credentials belong here. A tracker enabled in config with a MISSING
# gating credential is a BOOT ERROR (build_tracker_registry fails loud), so
# keep the two files in sync.
#
# Legend: "CONSUMED" = read by the code (see personalscraper/api/_activation.py);
#         "operator note" = present in the real .env but read by NO code — kept
#         here as documentation only.

# C411 — Torznab (first named config of api/tracker/torznab.py).
# CONSUMED: PROVIDER_CREDS["c411"] gates activation on the API key.
C411_API_KEY=
# CONSUMED (non-gating): PROVIDER_OPTIONAL_SECRETS — announce passkey, used by
# the Vague-5 seeding consumers (Ratio C1, Seed-Safety O2). A missing passkey
# never deactivates the tracker.
# C411_PASSKEY=
# Operator notes — NOT consumed by any code:
# C411_ANNOUNCE_URL=
# C411_TORZNAB_URL=
# C411_JACKETT_URL=
# C411_UPLOAD_API_ENDPOINT=
# C411_SOURCE=

# TR4KER — Torznab (second named config). Replaces the closed torr9.
# Two distinct secrets, two distinct roles — they are NOT interchangeable.
# CONSUMED (gating): the PROFILE API key (Mon compte → Paramètres), sent as the
# Torznab `apikey=` query parameter. A 401 / `<error code="100">` on a search
# means THIS value is wrong. See docs/reference/tr4ker-api.md.
TR4KER_API_KEY=
# CONSUMED (non-gating): the announce passkey embedded in the .torrent files —
# it identifies the account for announce + RSS (future freeleech radar R1) and
# never authenticates the search API. Its absence never deactivates tr4ker.
TR4KER_PASSKEY=
# Operator notes — NOT consumed by any code (TR4KER_USERNAME / TR4KER_PASSWORD
# are leftovers from the login-style torr9 client and are deliberately unwired):
# TR4KER_USERNAME=
# TR4KER_PASSWORD=
# TR4KER_API_URL=
# TR4KER_ANNOUNCE_URL=

# ── DEPRECATED (tracker closed 2026-07, replaced by tr4ker) ────────────────
# torr9.net shut down; the client, its activation entries and its config block
# were removed in 0.57.0. NOTHING below is read by any code — the entries are
# kept documented so an operator recognises the leftovers in their own .env.
# The historical seed obligations recorded against this tracker stay valid in
# acquire.db and are deliberately not migrated.
# TORR9_USERNAME=
# TORR9_PASSWORD=
# TORR9_PASSKEY=
# TORR9_API_URL=
# TORR9_ANNOUNCE_URL=

# ── Maintenance runner (internal) ────────────────
# Set internally by the web maintenance action spawner for the runner
# subprocess (personalscraper/web/maintenance/runner.py).
# Not operator-configured.
# PERSONALSCRAPER_MAINT_COMMAND=
# PERSONALSCRAPER_MAINT_DRY_RUN=
# PERSONALSCRAPER_MAINT_OPTIONS_JSON=

# ── Decisions runner (internal) ──────────────────
# Set internally by the web decision-resolve spawner for the runner
# subprocess (personalscraper/web/decisions/runner.py).
# Not operator-configured.
# PERSONALSCRAPER_DECISION_ID=
# PERSONALSCRAPER_DECISION_PROVIDER=
# PERSONALSCRAPER_DECISION_PROVIDER_ID=
# PERSONALSCRAPER_DECISION_VIA=

# ── Grab runner (internal) ───────────────────────
# Set internally by the web per-series grab-trigger spawner for the runner
# subprocess (personalscraper/web/acquisition/runner.py).
# Not operator-configured.
# PERSONALSCRAPER_GRAB_FOLLOWED_ID=

# ── Pipeline-queue waiter (internal) ─────────────
# Set internally by POST /api/pipeline/run when a maintenance run holds the
# lock, for the detached waiter (personalscraper/web/pipeline_queue.py).
# Not operator-configured.
# PERSONALSCRAPER_PQ_TRIGGER_REASON=
# PERSONALSCRAPER_PQ_DRY_RUN=

# Resolve queue: max seconds a web scrape-resolve waits for pipeline.lock
# before giving up (visible 'queue' state; default 1800 = 30 min).
PERSONALSCRAPER_RESOLVE_QUEUE_TIMEOUT=1800

# Maintenance queue (§6): max seconds a web maintenance action waits for
# pipeline.lock in the visible queue before giving up (default 1800 = 30 min).
PERSONALSCRAPER_MAINT_QUEUE_TIMEOUT=1800

# Pipeline queue (§6): max seconds a queued web pipeline launch waits for
# pipeline.lock before giving up (default 1800 = 30 min).
PERSONALSCRAPER_PIPELINE_QUEUE_TIMEOUT=1800
