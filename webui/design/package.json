{
  "name": "torrentmate-maquette",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --mode app",
    "check:app-bundle": "node app-bundle.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "generate-contract-types": "tools/contract-types/node_modules/.bin/openapi-typescript ../../contract/openapi.json -o src/contract/types.d.ts",
    "stamp-operation-rights": "node --experimental-strip-types --no-warnings scripts/stamp-operation-rights.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-virtual": "^3.14.17",
    "@tanstack/store": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "firebase": "13.0.0",
    "i18next": "^26.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  }
}
