#!/usr/bin/env bash
# Pre-push hook: the fast static checks. The full pytest runs in CI, not here.
#
# Install: hooks/install.sh (hooks/pre-push is a link to this file)
# Bypass:  git push --no-verify

set -euo pipefail

# A hook inherits the pushing git's environment; these would point every git
# call below at the wrong repository when the push comes from a worktree.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

failures=0

run_check() {
  local label="$1"; shift
  printf "%s ... " "$label"
  local output
  output="$(mktemp)"
  if "$@" > "$output" 2>&1; then
    printf "OK\n"
  else
    printf "FAILED\n"
    sed 's/^/    /' "$output"
    failures=$((failures + 1))
  fi
  rm -f "$output"
}

run_check "ruff check"          python -m ruff check personalscraper/ tests/ scripts/ webui/harness/ frontend/scripts/
run_check "ruff format --check" python -m ruff format --check personalscraper/ tests/
run_check "mypy"                python -m mypy personalscraper/

if [[ "$failures" -eq 0 ]]; then
  exit 0
fi
echo "pre-push: $failures check(s) failed. Push aborted (bypass: git push --no-verify)."
exit 1
