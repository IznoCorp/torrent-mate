{
  // PROVIDER_CREDS: lacale → LACALE_API_KEY, c411 → C411_API_KEY, tr4ker → TR4KER_PASSKEY
  // PROVIDER_OPTIONAL_SECRETS (non-gating): lacale → LACALE_PASSKEY, c411 → C411_PASSKEY
  // tr4ker: single secret — TR4KER_PASSKEY, whose value is sent as the Torznab
  //   `apikey=` query param (and will serve the RSS radar later), so it gates activation.
  tracker: {
    providers: {
      lacale: { enabled: false, cross_seed: false }, // deprecated + unreachable (la-cale.space down) — disabled to stop CircuitOpenError crashing grab
      c411: {
        enabled: true,
        cross_seed: false,
        economy: {
          target_ratio: 2.0,
          min_ratio: 1.0,
          min_seed_time: "72h",
          hit_and_run_grace: "0h",
        },
      },
      tr4ker: {
        // Active: TR4KER_PASSKEY is present in .env. Keep it that way — an
        // enabled tracker with missing credentials is a BOOT ERROR
        // (build_tracker_registry raises TrackerConfigError → every command
        // fails), so removing the secret requires flipping this back to false.
        enabled: false,
        cross_seed: false,
        // economy: TR4KER publishes no explicit seeding obligation (no documented
        // min seed time / H&R grace), so no values are invented here. Until the
        // operator fills this block in, dispatch records an honest
        // tracker-unresolved MISS for tr4ker torrents instead of a wrong rule.
        // economy: {
        //   target_ratio: 2.0,
        //   min_ratio: 1.0,
        //   min_seed_time: "72h",
        //   hit_and_run_grace: "0h",
        // },
      },
    },
    priority: ["c411", "tr4ker"], // c411 first: proven main tracker; swap here to prefer tr4ker
    max_total_results: 50,
    max_per_tracker: 30,
    timeout_per_tracker: 15,
  },
}
