    "/accounts/{accountId}": {
      "patch": {
        "description": "Put an account on its one role.\n\nArgs:\n    account_id: The account.\n    body: The role.\n    signed_in: The signed-in actor.\n    app_services: The application services.\n\nReturns:\n    The account, on its new role.",
        "operationId": "updateAccount",
        "parameters": [
          {
            "description": "the account",
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "description": "the account",
              "title": "Accountid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAccountBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
