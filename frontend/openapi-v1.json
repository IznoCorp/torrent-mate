{
  "components": {
    "schemas": {
      "AccountModel": {
        "additionalProperties": false,
        "description": "The contract's ``Account``: who is signed in, and what the instance forbids.\n\nAttributes:\n    name: The display name.\n    email: The e-mail.\n    avatar: The picture's address; absent for an account that has none.\n    id: The account's key.\n    role: Its one role.\n    sign_in_kind: How it signs in.\n    forbidden_writes: The instance's forbidden writes.",
        "properties": {
          "avatar": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "forbiddenWrites": {
            "items": {
              "$ref": "#/components/schemas/Right"
            },
            "title": "Forbiddenwrites",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/RoleModel"
          },
          "signInKind": {
            "$ref": "#/components/schemas/SignInKind"
          }
        },
        "required": [
          "name",
          "email",
          "id",
          "role",
          "signInKind",
          "forbiddenWrites"
        ],
        "title": "AccountModel",
        "type": "object"
      },
      "AccountSummaryModel": {
        "additionalProperties": false,
        "description": "The contract's ``AccountSummary``: one account of the roster.\n\nAttributes:\n    id: The account's key.\n    name: Its display name.\n    email: Its e-mail.\n    role: Its one role.\n    sign_in_kind: How it signs in.\n    demoted_from: The role it held before its Plex link demoted it; absent otherwise.",
        "properties": {
          "demotedFrom": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Demotedfrom"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/RoleModel"
          },
          "signInKind": {
            "$ref": "#/components/schemas/SignInKind"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "signInKind"
        ],
        "title": "AccountSummaryModel",
        "type": "object"
      },
      "ChangeOwnPasswordBody": {
        "additionalProperties": false,
        "description": "``changeOwnPassword``'s body.\n\nAttributes:\n    current_password: The password the account holds now.\n    new_password: The password that replaces it.",
        "properties": {
          "currentPassword": {
            "title": "Currentpassword",
            "type": "string"
          },
          "newPassword": {
            "title": "Newpassword",
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "title": "ChangeOwnPasswordBody",
        "type": "object"
      },
      "CreateAccountBody": {
        "additionalProperties": false,
        "description": "``createAccount``'s body.\n\nAttributes:\n    name: The display name.\n    email: The e-mail, every account's login.\n    role: The role it starts on; absent for the role local accounts start on.\n    password: The provisional password; only its hash is kept.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "title": "CreateAccountBody",
        "type": "object"
      },
      "CreateRoleBody": {
        "additionalProperties": false,
        "description": "``createRole``'s body.\n\nAttributes:\n    name: The role's name.\n    rights: The rights it carries.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "rights": {
            "items": {
              "$ref": "#/components/schemas/Right"
            },
            "title": "Rights",
            "type": "array"
          }
        },
        "required": [
          "name",
          "rights"
        ],
        "title": "CreateRoleBody",
        "type": "object"
      },
      "PasswordSet": {
        "additionalProperties": false,
        "description": "The acknowledgement of a password write (``changeOwnPassword``, ``resetAccountPassword``).\n\nAttributes:\n    ok: Always true: the password is set.",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "PasswordSet",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "The contract's ``Problem`` (``#/components/schemas/Problem``).\n\nAttributes:\n    status: The HTTP status, repeated in the body.\n    title: What went wrong, in one English line \u2014 the code's title.\n    detail: The real reason, an English developer line; never shown as is.\n    code: The refusal's code; the interface renders it through ``fr.json``.\n    params: The typed facts the interface composes its sentence from.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/RefusalCode"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "status",
          "title",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RefusalCode": {
        "description": "The closed set of refusal codes v1 answers (X4).\n\nEach lot adds its members; the interface owns every word (``fr.json``, by code).",
        "enum": [
          "request.invalid",
          "request.cross_origin",
          "route.unknown",
          "internal",
          "auth.required",
          "auth.refused",
          "auth.plex_only",
          "auth.rate_limited",
          "right.missing",
          "instance.read_only",
          "instance.forbidden_write",
          "account.unknown",
          "account.email_invalid",
          "account.email_taken",
          "account.admin_untouchable",
          "account.last_admin",
          "role.unknown",
          "role.system_immutable",
          "role.own_role",
          "role.escalation",
          "right.unknown",
          "password.required",
          "password.too_short",
          "password.current_wrong",
          "password.held_by_cli",
          "password.reset_admin_only",
          "media.not_found",
          "provider.unavailable"
        ],
        "title": "RefusalCode",
        "type": "string"
      },
      "ResetAccountPasswordBody": {
        "additionalProperties": false,
        "description": "``resetAccountPassword``'s body.\n\nAttributes:\n    password: The provisional password an Admin gives the account.",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "ResetAccountPasswordBody",
        "type": "object"
      },
      "Right": {
        "description": "One right of the ACL, in the contract's own names (``#/components/schemas/Right``).",
        "enum": [
          "library.read",
          "library.delete",
          "library.rescrape",
          "acquisition.request",
          "acquisition.follow",
          "acquisition.pilot.own",
          "acquisition.pilot.any",
          "acquisition.see.others",
          "acquisition.todo.view",
          "acquisition.quality.own",
          "acquisition.pause.own",
          "acquisition.reassign",
          "pipeline.control",
          "trackers.view",
          "trackers.control",
          "trackers.upload",
          "system.view",
          "configuration.view",
          "configuration.write",
          "accounts.manage"
        ],
        "title": "Right",
        "type": "string"
      },
      "RoleKind": {
        "description": "The contract's role kinds: the one Admin role and every other one.",
        "enum": [
          "admin",
          "ordinary"
        ],
        "title": "RoleKind",
        "type": "string"
      },
      "RoleModel": {
        "additionalProperties": false,
        "description": "The contract's ``Role``.\n\nAttributes:\n    id: The role's key.\n    name: Its name when an Admin gave it one; absent on a seeded role never renamed.\n    kind: ``admin`` or ``ordinary``.\n    rights: The rights it carries; empty for Admin.\n    default_for: Who starts on it; absent for a role nobody starts on.",
        "properties": {
          "defaultFor": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "plexHome",
                    "plexGuest",
                    "local"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Defaultfor"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RoleKind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "rights": {
            "items": {
              "$ref": "#/components/schemas/Right"
            },
            "title": "Rights",
            "type": "array"
          }
        },
        "required": [
          "id",
          "kind",
          "rights"
        ],
        "title": "RoleModel",
        "type": "object"
      },
      "RosterModel": {
        "additionalProperties": false,
        "description": "The contract's ``Roster``: every account and every role.\n\nAttributes:\n    accounts: The accounts.\n    roles: The roles.",
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountSummaryModel"
            },
            "title": "Accounts",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleModel"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "accounts",
          "roles"
        ],
        "title": "RosterModel",
        "type": "object"
      },
      "SignInBody": {
        "additionalProperties": false,
        "description": "``signIn``'s body: the password door's two fields.\n\nAttributes:\n    email: The account's e-mail \u2014 every account's login, matched whatever its case.\n    password: The password typed.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInBody",
        "type": "object"
      },
      "SignInKind": {
        "description": "How an account signs in \u2014 a fact of the account, never of its role (the contract's ``SignInKind``).",
        "enum": [
          "owner",
          "plex",
          "local"
        ],
        "title": "SignInKind",
        "type": "string"
      },
      "SignedOut": {
        "additionalProperties": false,
        "description": "``signOut``'s acknowledgement.\n\nAttributes:\n    ok: Always true: the session is closed.",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "SignedOut",
        "type": "object"
      },
      "UpdateAccountBody": {
        "additionalProperties": false,
        "description": "``updateAccount``'s body.\n\nAttributes:\n    role: The role the account is put on.",
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "UpdateAccountBody",
        "type": "object"
      },
      "UpdateRoleBody": {
        "additionalProperties": false,
        "description": "``updateRole``'s body; an absent field is left as it is.\n\nAttributes:\n    name: The new name.\n    rights: The new rights, replacing the list whole.",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "rights": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Right"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rights"
          }
        },
        "title": "UpdateRoleBody",
        "type": "object"
      },
      "Version": {
        "additionalProperties": false,
        "description": "``readVersion``'s answer (the contract's ``GET /version`` 200).\n\nAttributes:\n    version: The package version the running process serves.\n    commit: The git commit it booted with, or ``\"dev\"``.",
        "properties": {
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit"
        ],
        "title": "Version",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TorrentMate",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/accounts": {
      "get": {
        "description": "Every account and every role; a caller who is not Admin sees no Admin account.\n\nArgs:\n    signed_in: The signed-in actor.\n    app_services: The application services.\n\nReturns:\n    The roster.",
        "operationId": "readAccounts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterModel"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          }
        },
        "summary": "Read Accounts"
      },
      "post": {
        "description": "Create a local account with its provisional password.\n\nArgs:\n    body: Its name, e-mail, role and provisional password.\n    signed_in: The signed-in actor.\n    app_services: The application services.\n\nReturns:\n    The account, on its initial role.",
        "operationId": "createAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
