    "/accounts/{accountId}/password": {
      "post": {
        "description": "Give a local account a provisional password; its sessions keep running.\n\nArgs:\n    account_id: The account.\n    body: The provisional password.\n    signed_in: The signed-in actor.\n    app_services: The application services.\n\nReturns:\n    ``{\"ok\": true}``.",
        "operationId": "resetAccountPassword",
        "parameters": [
          {
            "description": "the account",
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "description": "the account",
              "title": "Accountid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetAccountPasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordSet"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A refusal, answered as a Problem."
          },
          "500": {
